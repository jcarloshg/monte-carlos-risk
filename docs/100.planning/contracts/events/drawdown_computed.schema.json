{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-risk.local/contracts/events/drawdown_computed.schema.json",
  "title": "DrawdownComputed",
  "description": "Emitted once per 1,000-path batch (ADR-009) after PathSampled for the same range.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pathIndexRange", "maxDrawdowns"],
  "properties": {
    "pathIndexRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "maxDrawdowns": {
      "type": "array",
      "description": "Per-path MaxDrawdown ∈ [0, 1]. Same length as the batch.",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
