{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-risk.local/contracts/events/simulation_failed.schema.json",
  "title": "SimulationFailed",
  "description": "Terminal failure event. Run transitions to FAILED on emission. Same shape as the canonical CLI error response (Defining 300-Q4.7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["errorCode", "message"],
  "properties": {
    "errorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "PORTFOLIO_NOT_FOUND",
        "RETURNS_FILE_NOT_FOUND",
        "INSUFFICIENT_MEMORY",
        "ASSERTION_FAILED",
        "INFRASTRUCTURE_ERROR",
        "RUNTIME_TIMEOUT",
        "DOMAIN_ERROR"
      ],
      "description": "Stable identifier; maps to CLI exit code (Defining 300-Q6.4)."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable; never includes file contents (Defining 300-Q6.11)."
    },
    "details": {
      "type": "array",
      "description": "Field-level validation errors, etc. Each entry points at a JSONPath-like field name and expected/actual values.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["field"],
        "properties": {
          "field": { "type": "string" },
          "expected": true,
          "actual": true
        }
      }
    },
    "pathIndexRange": {
      "type": "object",
      "description": "If the failure occurred mid-batch, the range that was being processed when the error was raised.",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "exclusiveMinimum": 0 }
      }
    }
  }
}
