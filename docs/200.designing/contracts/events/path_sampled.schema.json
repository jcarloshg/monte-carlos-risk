{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-risk.local/contracts/events/path_sampled.schema.json",
  "title": "PathSampled",
  "description": "Emitted once per 1,000-path batch (ADR-009). pathIndexRange is [start, end), inclusive of start, exclusive of end.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pathIndexRange", "batchSize"],
  "properties": {
    "pathIndexRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "const": 1000
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock milliseconds for this batch."
    }
  }
}
