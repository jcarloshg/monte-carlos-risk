{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-risk.local/contracts/events/risk_metrics_calculated.schema.json",
  "title": "RiskMetricsCalculated",
  "description": "Emitted exactly once per run, after all PathSampled + DrawdownComputed batches.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meanTerminal", "stdTerminal", "varByConfidence", "cvarByConfidence"],
  "properties": {
    "meanTerminal": { "type": "number", "minimum": 0 },
    "stdTerminal": { "type": "number", "minimum": 0 },
    "varByConfidence": {
      "type": "object",
      "description": "Map of confidence level (e.g. \"0.95\") -> VaR as a positive number representing the loss threshold.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^0\\.[0-9]{1,4}$"
      },
      "propertyNames": { "pattern": "^0\\.[0-9]{1,4}$" }
    },
    "cvarByConfidence": {
      "type": "object",
      "description": "Map of confidence level -> CVaR. CVaR >= VaR for every key (Defining Q1.6 invariant; asserted in tests).",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "maxDrawdownDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max"],
      "description": "Summary quantiles of the per-path MaxDrawdown array.",
      "properties": {
        "p50": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95": { "type": "number", "minimum": 0, "maximum": 1 },
        "p99": { "type": "number", "minimum": 0, "maximum": 1 },
        "max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
